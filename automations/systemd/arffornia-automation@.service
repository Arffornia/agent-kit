# systemd user service template: one agent-kit automation, run with the logged-in claude CLI.
# Installed by automations/install-local.sh into ~/.config/systemd/user/. %i = agent name.
[Unit]
Description=Arffornia automation %i (agent-kit)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# install-local.sh writes the agent-kit checkout path here.
ExecStart=/usr/bin/env bash @KIT@/automations/run-local.sh %i @KIT@
Environment=PATH=%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=10
